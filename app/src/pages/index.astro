---
// Root fallback. Cloudflare Pages honors public/_redirects (/ -> /en, 302)
// before this ever renders; this covers hosts that don't process it.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/en" />
    <link rel="canonical" href="/en" />
    <title>A Civilizational Curriculum for Leaders</title>
  </head>
  <body>
    <p>Redirecting to <a href="/en">the English edition</a>…</p>
  </body>
</html>
