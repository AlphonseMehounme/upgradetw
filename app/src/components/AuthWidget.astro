---
import { ui } from "../lib/content.js";

interface Props {
  lang: "en" | "fr";
}
const { lang } = Astro.props;
const T = ui(lang);
---

<div class="auth-widget" data-auth-root data-lang={lang}>
  <button type="button" data-auth-signin>{T.authSignIn}</button>
  <a href={`/${lang}/profile`} data-auth-profile-link hidden>{T.authProfile}</a>
  <button type="button" data-auth-signout hidden>{T.authSignOut}</button>
</div>

<script>
  import { initAuth } from "../scripts/auth-app.js";
  import { initSync } from "../scripts/sync.js";
  initAuth();
  initSync();
</script>
