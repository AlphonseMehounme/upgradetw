---
import { TOTAL_MAX, ui } from "../lib/content.js";

interface Props {
  lang: "en" | "fr";
  groups: any[];
}
const { lang, groups } = Astro.props;
const T = ui(lang);
---

<section class="overall">
  <div class="overall-hd">
    <div class="big">
      <b data-progress-hours>0</b>
      <span data-progress-rest
        >/ {TOTAL_MAX} {T.hoursRead} · 0/38 {T.works}</span>
    </div>
    <button class="linkbtn" data-reset-progress>{T.resetProgress}</button>
  </div>
  <div class="obar" data-overall-bar>
    {
      groups.map((g) => {
        const mx = g.books.reduce((a: number, b: any) => a + b.h[1], 0);
        return (
          <span
            class="oseg"
            data-seg-key={g.key}
            data-seg-max={mx}
            style={`--c:${g.accent};flex:0 0 ${(mx / TOTAL_MAX) * 100}%`}
            title={`${g.title} — ${mx} ${T.hours}`}
          >
            <i style="--f:0%" />
          </span>
        );
      })
    }
  </div>
</section>
